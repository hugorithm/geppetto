DISCORD_TOKEN=
# Select live for gpt-live-1, or realtime for conversational Realtime models.
# When unset, the application defaults to realtime.
VOICE_API=live
# Example endpoint: https://your-resource.openai.azure.com
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Your gpt-live-1 deployment name in Live mode; Realtime deployment otherwise.
AZURE_OPENAI_DEPLOYMENT_NAME=
# Live only: your Responses API backend deployment name (e.g. a gpt-6-luna deployment).
AZURE_OPENAI_LIVE_BACKEND_DEPLOYMENT_NAME=


# Optional direct OpenAI fallback: ignored when AZURE_OPENAI_ENDPOINT is set.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_LIVE_BACKEND_MODEL=gpt-6-luna

# Optional: register commands instantly in this server during development.
DISCORD_GUILD_ID=
OPENAI_VOICE=ash
SYSTEM_PROMPT="You are Geppetto, an AI voice assistant in a Discord call. Speak naturally, keep responses concise, and respond in the user's language."
RUST_LOG=geppetto=info,warn